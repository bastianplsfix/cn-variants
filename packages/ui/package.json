{
  "name": "@cn-variants/ui",
  "version": "0.0.1",
  "private": true,
  "description": "React Button and Badge components with automatically imported, compiled Tailwind CSS.",
  "homepage": "https://cn-variants.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastianplsfix/cn-variants.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vp pack && vp exec tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "cn-variants": "^3.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
